# Copy to ~mira/.config/mira/listen.env. Every backend is a URL, none is assumed local, so Agent OS,
# Hermes and music-api can move to the Mac mini later by editing these lines.
# Tailscale address of the mini (encrypted, authenticated); never an mDNS name, the token travels in this request.
MIRA_SPEECH_URL=http://100.77.98.89:8765
MIRA_HERMES_URL=http://127.0.0.1:8642
MIRA_VOICE_URL=http://127.0.0.1:3456/api/hooks/voice
MIRA_MUSIC_URL=http://127.0.0.1:4534

# Wake word. Tuned 2026-11-09 against recordings from the JV603 at arm's length, 2 m and across the room: speech arrives
# at rms 0.003 to 0.02, so the default 0.15 never fired from afar. Lower is easier to wake; the transcript check on the
# wake clip (has_wake) throws away look-alikes that get through.
MIRA_KWS_THRESHOLD=0.05
MIRA_KWS_SCORE=1.0
# Software AGC on the mic (MIRA_AGC=0 turns it off). Lifts quiet speech toward TARGET rms, at most MAX_GAIN times;
# a quiet room relaxes to REST times; chunks under GATE x the tracked noise floor never raise the gain; CEILING is the
# peak a boosted chunk may reach (no clipping). These are the defaults.
MIRA_AGC=1
MIRA_AGC_TARGET=0.05
MIRA_AGC_MAX_GAIN=10
MIRA_AGC_REST=3
MIRA_AGC_GATE=1.8
