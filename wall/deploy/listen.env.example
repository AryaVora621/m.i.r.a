# Copy to ~mira/.config/mira/listen.env. Every backend is a URL, none is assumed local, so Agent OS,
# Hermes and music-api can move to the Mac mini later by editing these lines.
# Tailscale address of the mini (encrypted, authenticated); never an mDNS name, the token travels in this request.
MIRA_SPEECH_URL=http://100.77.98.89:8765
MIRA_HERMES_URL=http://127.0.0.1:8642
MIRA_VOICE_URL=http://127.0.0.1:3456/api/hooks/voice
MIRA_MUSIC_URL=http://127.0.0.1:4534
